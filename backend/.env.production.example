APP_NAME="Z draft API"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.zdraft.example.com
APP_TIMEZONE=Africa/Cairo

FRONTEND_URL=https://zdraft.example.com
DASHBOARD_URL=https://admin.zdraft.example.com

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=zdraft
DB_USERNAME=zdraft
DB_PASSWORD=CHANGE_TO_A_STRONG_DATABASE_PASSWORD
DB_SSLMODE=prefer

SUPER_ADMIN_NAME="Z draft Super Admin"
SUPER_ADMIN_EMAIL=admin@zdraft.example.com
SUPER_ADMIN_PASSWORD=CHANGE_TO_A_STRONG_16_PLUS_CHARACTER_PASSWORD
SUPER_ADMIN_RESET_PASSWORD=false

CACHE_STORE=database
QUEUE_CONNECTION=sync
SESSION_DRIVER=array

ZDRAFT_FRONTEND_SESSION_COOKIE=zdraft_user_session
ZDRAFT_FRONTEND_CSRF_COOKIE=zdraft_user_csrf
ZDRAFT_DASHBOARD_SESSION_COOKIE=zdraft_admin_session
ZDRAFT_DASHBOARD_CSRF_COOKIE=zdraft_admin_csrf
COOKIE_DOMAIN=.zdraft.example.com
COOKIE_SAME_SITE=lax
COOKIE_SECURE=true
SESSION_TTL_HOURS=168
EMAIL_OTP_TTL_MINUTES=10
EMAIL_OTP_MAX_ATTEMPTS=5
EMAIL_OTP_RESEND_COOLDOWN_SECONDS=60
PASSWORD_RESET_TTL_MINUTES=30
EXPOSE_DEBUG_TOKENS=false

MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=465
MAIL_USERNAME=notifications@zdraft.example.com
MAIL_PASSWORD=CHANGE_TO_SMTP_OR_APP_PASSWORD
MAIL_SCHEME=smtps
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=notifications@zdraft.example.com
MAIL_FROM_NAME="Z draft"
MAIL_REPLY_TO_ADDRESS=support@zdraft.example.com
MAIL_REPLY_TO_NAME="Z draft Support"

FILESYSTEM_DISK=private
PRIVATE_STORAGE_ROOT=/var/lib/zdraft/private
PDF_STORAGE_ROOT=/var/lib/zdraft/contracts
IMAGE_MAX_DIMENSION=1920
IMAGE_MAX_INPUT_PIXELS=40000000
IMAGE_MAX_BYTES=1572864
IMAGE_THUMBNAIL_DIMENSION=480
IMAGE_WEBP_QUALITY=84
IMAGE_WEBP_EFFORT=6
IMAGE_THUMBNAIL_QUALITY=72
IMAGE_PRESERVE_ORIGINAL=false

CLAMAV_ENABLED=false
CLAMAV_BINARY=clamscan

WEASYPRINT_BINARY=/usr/bin/weasyprint
PDF_TIMEOUT_SECONDS=120

NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_TEMPLATE_SOURCE=api
NEXT_PUBLIC_DRAFT_SOURCE=api-only

FEATURE_TEAM_MANAGEMENT=false
FEATURE_ASSIGNMENT=false
FEATURE_OFFICE_CONTRACT_CREATION=false
FEATURE_CONTRACT_EDITING=false
FEATURE_TEMPLATE_MANAGEMENT=false
