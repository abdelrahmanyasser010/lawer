[Unit]
Description=Z draft Laravel scheduler worker
After=network.target postgresql.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/zdraft/backend
ExecStart=/usr/bin/php artisan schedule:work
Restart=always
RestartSec=5
Environment=APP_ENV=production

[Install]
WantedBy=multi-user.target
