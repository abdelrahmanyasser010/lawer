{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "zdraft/backend",
  "type": "project",
  "description": "Z draft legal contracts platform API - Laravel backend",
  "keywords": [
    "laravel",
    "legal",
    "contracts",
    "api"
  ],
  "license": "proprietary",
  "require": {
    "ext-fileinfo": "*",
    "ext-imagick": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-openssl": "*",
    "ext-pdo": "*",
    "ext-pdo_pgsql": "*",
    "laravel/framework": "^13.8",
    "laravel/tinker": "^3.0",
    "php": "^8.4",
    "symfony/process": "^8.0"
  },
  "require-dev": {
    "fakerphp/faker": "^1.23",
    "laravel/pint": "^1.27",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.6",
    "phpunit/phpunit": "^12.5.12"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "test": [
      "@php artisan test"
    ],
    "doctor": [
      "@php artisan zdraft:doctor --json"
    ],
    "verify": [
      "@php artisan route:list --path=api/v1",
      "@php artisan test",
      "@verify:static"
    ],
    "verify:static": [
      "@php tools/run_python.php tools/verify_route_compatibility.py",
      "node tools/verify_frontend_api_contract.mjs",
      "@php tools/run_python.php tools/verify_response_contracts_v20.py",
      "@php tools/run_python.php tools/verify_sql_placeholders.py",
      "@php tools/run_python.php tools/verify_laravel_final_v20.py"
    ]
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
